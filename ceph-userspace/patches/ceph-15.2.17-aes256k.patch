+// ---------------------------------------------------
+// AES256-CTS-HMAC-SHA384-192 (RFC 8009, krb5 enctype 20) — cephx aes256k.
+// Backported (route A) from upstream ceph src/auth/Crypto.cc. Uses OpenSSL 3.0
+// EVP AES-256-CBC-CTS (CS3) + HMAC-SHA384; per-usage keys Ke/Ki are derived
+// lazily and cached. Interop with the cluster was validated by aes256k_poc.c.
+
+class CryptoAES256KRB5 : public CryptoHandler {
+public:
+  CryptoAES256KRB5() { }
+  ~CryptoAES256KRB5() override {}
+  int get_type() const override {
+    return CEPH_CRYPTO_AES256KRB5;
+  }
+  int create(CryptoRandom *random, bufferptr& secret) override;
+  int validate_secret(const bufferptr& secret) override;
+  CryptoKeyHandler *get_key_handler(const bufferptr& secret, string& error) override;
+};
+
+struct EVPCipherDeleter {
+  void operator()(EVP_CIPHER* ptr) const noexcept {
+    if (ptr) { EVP_CIPHER_free(ptr); }
+  }
+};
+struct EVPCipherCtxDeleter {
+  void operator()(EVP_CIPHER_CTX* ptr) const noexcept {
+    if (ptr) { EVP_CIPHER_CTX_free(ptr); }
+  }
+};
+
+static constexpr const std::size_t AES256KRB5_KEY_LEN{32};
+static constexpr const std::size_t AES256KRB5_BLOCK_LEN{16};
+static constexpr const std::size_t AES256KRB5_HASH_LEN{24};
+static constexpr const std::size_t SHA384_LEN{48};
+
+class CryptoAES256KRB5KeyHandler : public CryptoKeyHandler {
+  std::unique_ptr<EVP_CIPHER, EVPCipherDeleter> cipher;
+
+  struct usage_keys {
+    ceph::bufferlist ki;
+    const unsigned char *ki_raw = nullptr;
+    ceph::bufferlist ke;
+    const unsigned char *ke_raw = nullptr;
+  };
+
+  mutable ceph::mutex lock = ceph::make_mutex("CryptoAES256KRB5KeyHandler");
+  mutable std::map<uint32_t, usage_keys> keys;
+
+  int do_init_usage_keys(uint32_t usage, usage_keys *uk, ostringstream& err) const {
+    int r = calc_kx(secret, usage, 0x55 /* Ki type */,
+                    AES256KRB5_HASH_LEN /* 192 bit */, uk->ki, err);
+    if (r < 0) {
+      return r;
+    }
+    uk->ki_raw = reinterpret_cast<const unsigned char *>(uk->ki.c_str());
+
+    r = calc_kx(secret, usage, 0xAA /* Ke type */,
+                32 /* 256 bit */, uk->ke, err);
+    if (r < 0) {
+      return r;
+    }
+    uk->ke_raw = reinterpret_cast<const unsigned char *>(uk->ke.c_str());
+    return 0;
+  }
+
+  const usage_keys *get_usage_keys(uint32_t usage) const {
+    std::unique_lock l(lock);
+    auto [it, inserted] = keys.emplace(std::piecewise_construct,
+                                       std::forward_as_tuple(usage),
+                                       std::forward_as_tuple());
+    if (inserted) {
+      std::ostringstream ss;
+      int r = do_init_usage_keys(usage, &it->second, ss);
+      if (r < 0) {
+        keys.erase(it);
+        return nullptr;
+      }
+    }
+    return &it->second;
+  }
+
+  static int calc_hmac_sha384(const unsigned char *data, int data_len,
+                              const unsigned char* hmac_key, int key_size,
+                              const unsigned char *iv, int iv_size,
+                              char *out, int out_size, ostringstream& err) {
+    unsigned int len = 0;
+    char _out[SHA384_LEN];
+    char *pout;
+    bool need_trim = (out_size < (int)sizeof(_out));
+    pout = need_trim ? _out : out;
+
+    /* IV (if any) is prepended to the data */
+    ceph::bufferlist source;
+    if (iv && iv_size > 0) {
+      ceph::bufferptr iv_buf(reinterpret_cast<const char *>(iv), iv_size);
+      source.push_back(iv_buf);
+    }
+    source.append((const char *)data, data_len);
+
+    HMAC(EVP_sha384(), hmac_key, key_size,
+         reinterpret_cast<const unsigned char *>(source.c_str()), source.length(),
+         (unsigned char *)pout, &len);
+
+    if (len != SHA384_LEN) {
+      err << "Unexpected calculated SHA384 length";
+      return -EIO;
+    }
+    if (need_trim) {
+      memcpy(out, pout, out_size);
+      len = out_size;
+    }
+    return len;
+  }
+
+  // RFC 8009 KDF: HMAC-SHA384(secret, 00000001 | usage_BE32 | type | 00 | (k*8)_BE32)[0:k]
+  static int calc_kx(const ceph::bufferptr& secret, uint32_t usage,
+                     uint8_t type, int k, ceph::bufferlist& out,
+                     ostringstream& err) {
+    unsigned char data[14];
+    data[0] = 0; data[1] = 0; data[2] = 0; data[3] = 1;    /* i = 1 */
+    data[4] = (usage >> 24) & 0xff; data[5] = (usage >> 16) & 0xff;
+    data[6] = (usage >>  8) & 0xff; data[7] =  usage        & 0xff;
+    data[8] = type; data[9] = 0;
+    uint32_t kb = (uint32_t)(k * 8);
+    data[10] = (kb >> 24) & 0xff; data[11] = (kb >> 16) & 0xff;
+    data[12] = (kb >>  8) & 0xff; data[13] =  kb        & 0xff;
+
+    ceph::bufferptr sha384(SHA384_LEN);
+    int r = calc_hmac_sha384(data, sizeof(data),
+                             reinterpret_cast<const unsigned char *>(secret.c_str()),
+                             secret.length(),
+                             nullptr, 0, /* no IV */
+                             sha384.c_str(), SHA384_LEN, err);
+    if (r < 0) {
+      return r;
+    }
+    bufferlist bl;
+    bl.append(sha384);
+    bl.splice(0, k, &out);
+    return r;
+  }
+
+  int encrypt_AES256_CTS(ceph::bufferlist& plaintext,
+                         const unsigned char* ke, const unsigned char* iv,
+                         unsigned char *ciphertext, int ciphertext_len) const {
+    if (!cipher) {
+      return -EINVAL;
+    }
+    if ((size_t)ciphertext_len < plaintext.length()) {
+      return -EINVAL;
+    }
+    OSSL_PARAM params[2] = {
+      OSSL_PARAM_construct_utf8_string(OSSL_CIPHER_PARAM_CTS_MODE, (char *)"CS3", 0),
+      OSSL_PARAM_construct_end() };
+
+    std::unique_ptr<EVP_CIPHER_CTX, EVPCipherCtxDeleter> ctx{EVP_CIPHER_CTX_new()};
+    if (!ctx) {
+      return -EIO;
+    }
+    if (!EVP_EncryptInit_ex2(ctx.get(), cipher.get(), ke, iv, params)) {
+      return -EIO;
+    }
+    int encrypted_len = 0, len;
+    if (EVP_EncryptUpdate(ctx.get(), ciphertext, &len,
+          (const unsigned char *)plaintext.c_str(), plaintext.length()) != 1) {
+      return -EIO;
+    }
+    encrypted_len += len;
+    if (EVP_EncryptFinal_ex(ctx.get(), ciphertext + encrypted_len, &len) != 1) {
+      return -EIO;
+    }
+    encrypted_len += len;
+    return encrypted_len;
+  }
+
+  int decrypt_AES256_CTS(ceph::bufferlist& ciphertext,
+                         const unsigned char* ke, const unsigned char* iv,
+                         ceph::bufferptr& plaintext) const {
+    if (!cipher) {
+      return -EINVAL;
+    }
+    OSSL_PARAM params[2] = {
+      OSSL_PARAM_construct_utf8_string(OSSL_CIPHER_PARAM_CTS_MODE, (char *)"CS3", 0),
+      OSSL_PARAM_construct_end() };
+
+    std::unique_ptr<EVP_CIPHER_CTX, EVPCipherCtxDeleter> ctx{EVP_CIPHER_CTX_new()};
+    if (!ctx) {
+      return -EIO;
+    }
+    if (!EVP_DecryptInit_ex2(ctx.get(), cipher.get(), ke, iv, params)) {
+      return -EIO;
+    }
+    int len, plaintext_len = 0;
+    auto dest = reinterpret_cast<unsigned char *>(plaintext.c_str());
+    // ciphertext.c_str() rebuilds a contiguous buffer if needed.
+    if (EVP_DecryptUpdate(ctx.get(), dest, &len,
+          (const unsigned char *)ciphertext.c_str(), ciphertext.length()) != 1) {
+      return -EIO;
+    }
+    plaintext_len += len;
+    if (EVP_DecryptFinal_ex(ctx.get(), dest + plaintext_len, &len) != 1) {
+      return -EIO;
+    }
+    plaintext_len += len;
+    return 0;
+  }
+
+public:
+  CryptoAES256KRB5KeyHandler() : CryptoKeyHandler(CryptoKeyHandler::BLOCK_SIZE_16B()) {}
+  ~CryptoAES256KRB5KeyHandler() = default;
+
+  int init(const ceph::bufferptr& s, ostringstream& err) {
+    cipher.reset(EVP_CIPHER_fetch(NULL, "AES-256-CBC-CTS", NULL));
+    if (!cipher) {
+      err << "Failed to fetch OpenSSL cipher AES-256-CBC-CTS";
+      return -EINVAL;
+    }
+    secret = s;
+    default_usage = 0;
+    // usage keys are derived lazily on first use (see get_usage_keys).
+    return 0;
+  }
+
+  // plain (usage-less) variants — route through the default usage. Not used by
+  // cephx after this backport, but required to satisfy the pure-virtual base.
+  int encrypt(const ceph::bufferlist& in, ceph::bufferlist& out,
+              std::string *error) const override {
+    return encrypt_ext(nullptr, default_usage, in, nullptr, out, error);
+  }
+  int decrypt(const ceph::bufferlist& in, ceph::bufferlist& out,
+              std::string *error) const override {
+    return decrypt_ext(nullptr, default_usage, in, out, error);
+  }
+
+  int encrypt_ext(CephContext *cct, uint32_t usage,
+                  const ceph::bufferlist& in,
+                  const ceph::bufferlist *confounder,
+                  ceph::bufferlist& out, std::string *error) const override {
+    // output layout: AES256-CTS( confounder | data ) | HMAC-SHA384[0:24]
+    ceph::bufferptr out_tmp{static_cast<unsigned>(
+      AES256KRB5_BLOCK_LEN + in.length() + AES256KRB5_HASH_LEN)};
+
+    char *aes_enc = out_tmp.c_str();
+    int aes_enc_len = AES256KRB5_BLOCK_LEN + in.length();
+
+    ceph::bufferlist incopy;
+    bufferptr confounder_buf(AES256KRB5_BLOCK_LEN);
+    if (!confounder) {
+      if (cct) {
+        cct->random()->get_bytes(confounder_buf.c_str(), confounder_buf.length());
+      } else {
+        CryptoRandom r;
+        r.get_bytes(confounder_buf.c_str(), confounder_buf.length());
+      }
+      incopy.append(confounder_buf);
+    } else {
+      if (confounder->length() != AES256KRB5_BLOCK_LEN) {
+        if (error) *error = "confounder length must equal block size";
+        return -EINVAL;
+      }
+      incopy.append(*confounder);
+    }
+    incopy.append(in);
+
+    unsigned char iv[AES256KRB5_BLOCK_LEN];
+    memset(iv, 0, sizeof(iv));
+
+    auto *uk = get_usage_keys(usage);
+    if (!uk) {
+      if (error) *error = "cannot derive usage keys";
+      return -EIO;
+    }
+
+    int r = encrypt_AES256_CTS(incopy, uk->ke_raw, iv,
+                               (unsigned char *)aes_enc, aes_enc_len);
+    if (r < 0) {
+      return r;
+    }
+    aes_enc_len = r;
+
+    char *hmac = out_tmp.c_str() + AES256KRB5_BLOCK_LEN + in.length();
+    ostringstream err;
+    r = calc_hmac_sha384((const unsigned char *)aes_enc, aes_enc_len,
+                         uk->ki_raw, uk->ki.length(),
+                         iv, sizeof(iv), hmac, AES256KRB5_HASH_LEN, err);
+    if (r < 0) {
+      if (error) *error = err.str();
+      return r;
+    }
+    out.append(out_tmp);
+    return 0;
+  }
+
+  int decrypt_ext(CephContext *cct, uint32_t usage,
+                  const ceph::bufferlist& in,
+                  ceph::bufferlist& out, std::string *error) const override {
+    if (in.length() < AES256KRB5_BLOCK_LEN + AES256KRB5_HASH_LEN) {
+      if (error) *error = "ciphertext too short";
+      return -EINVAL;
+    }
+    bufferlist incopy(in);       // shallow copy
+    ceph::bufferlist indata;
+    // split off the trailing HMAC:
+    //   indata <- AES256-CTS( confounder | plaintext )
+    //   incopy <- HMAC of indata
+    incopy.splice(0, in.length() - AES256KRB5_HASH_LEN, &indata);
+    auto& inhash = incopy;
+
+    unsigned char iv[AES256KRB5_BLOCK_LEN];
+    memset(iv, 0, sizeof(iv));
+
+    auto *uk = get_usage_keys(usage);
+    if (!uk) {
+      if (error) *error = "cannot derive usage keys";
+      return -EIO;
+    }
+
+    char hmac[AES256KRB5_HASH_LEN];
+    ostringstream err;
+    int r = calc_hmac_sha384((const unsigned char *)indata.c_str(), indata.length(),
+                             uk->ki_raw, uk->ki.length(),
+                             iv, sizeof(iv), hmac, sizeof(hmac), err);
+    if (r < 0) {
+      if (error) *error = err.str();
+      return r;
+    }
+    if ((size_t)r != inhash.length()) {
+      return -EPERM;
+    }
+    if (memcmp(hmac, inhash.c_str(), sizeof(hmac)) != 0) {
+      return -EPERM;
+    }
+
+    bufferptr tmp_out(indata.length());   // confounder | plaintext
+    r = decrypt_AES256_CTS(indata, uk->ke_raw, iv, tmp_out);
+    if (r < 0) {
+      return r;
+    }
+    if (tmp_out.length() < AES256KRB5_BLOCK_LEN) {
+      return -EPERM;
+    }
+    int data_len = tmp_out.length() - AES256KRB5_BLOCK_LEN;
+    out.append(tmp_out.c_str() + AES256KRB5_BLOCK_LEN, data_len);
+    return 0;
+  }
+};
+
+
+// ------------------------------------------------------------
+
+int CryptoAES256KRB5::create(CryptoRandom *random, bufferptr& secret)
+{
+  bufferptr buf(AES256KRB5_KEY_LEN);
+  random->get_bytes(buf.c_str(), buf.length());
+  secret = std::move(buf);
+  return 0;
+}
+
+int CryptoAES256KRB5::validate_secret(const bufferptr& secret)
+{
+  if (secret.length() < AES256KRB5_KEY_LEN) {
+    return -EINVAL;
+  }
+  return 0;
+}
+
+CryptoKeyHandler *CryptoAES256KRB5::get_key_handler(const bufferptr& secret,
+                                                    string& error)
+{
+  CryptoAES256KRB5KeyHandler *ckh = new CryptoAES256KRB5KeyHandler;
+  ostringstream oss;
+  if (ckh->init(secret, oss) < 0) {
+    error = oss.str();
+    delete ckh;
+    return NULL;
+  }
+  return ckh;
+}
